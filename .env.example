# Адрес сервера для приложения. В локальной разработке можно не задавать:
# приложение само обратится к тому же компьютеру, с которого загружено (порт 3000).
# Для сборки в магазин обязателен адрес сервера с https.
# Сюда нельзя записывать секреты: переменные EXPO_PUBLIC_ попадают в приложение.
EXPO_PUBLIC_API_URL=https://api.example.com
