# Скопируйте нужные значения в переменные окружения перед запуском сервера.

# Порт сервера
PORT=3000

# Файл базы данных SQLite
DB_PATH=server/data/campus.db

# Этот email получит права администратора при регистрации
ADMIN_EMAIL=

# Адрес источника реальных координат автобусов (JSON-массив вида
# [{"routeNumber":"12","lat":43.2,"lon":76.9,"updatedAt":"..."}]).
# Пока адрес не указан, приложение честно показывает только маршруты и остановки.
BUS_POSITIONS_URL=

# 0 — не создавать демо-общежитие в новой базе
SEED_DEMO_DORM=1
