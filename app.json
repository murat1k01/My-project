{
  "expo": {
    "name": "Campus Hub",
    "slug": "MyFirstApp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Campus Hub показывает ваше местоположение на карте автобусов, только когда вы об этом просите."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Campus Hub использует выбранное вами фото для профиля.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
